DATABASE_URL=postgresql://medical_ai:local_dev_only@127.0.0.1:5433/medical_ai
POSTGRES_USER=medical_ai
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=medical_ai
API_BASE_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_PROVIDER=ollama
CHAT_MODEL=gemma3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
DATA_DIR=./data
MAX_FILES=5
MAX_FILE_MB=20
MAX_TOTAL_MB=50
MAX_TOTAL_PAGES=300
CHUNK_TARGET_CHARS=1500
CHUNK_OVERLAP_CHARS=200
CHUNK_MAX_CHARS=2000
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_CANDIDATES=8
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=8000
MODEL_CONTEXT_TOKENS=16384
MAX_OUTPUT_TOKENS=512
MODEL_TIMEOUT_SECONDS=120
SESSION_TTL_HOURS=24
# Uncalibrated: pass retrieved evidence to the model for answerability checks.
MIN_SIMILARITY=-1.0

# Word (.doc/.docx) uploads use local LibreOffice to create the cited PDF.
# Auto-detects soffice or /Applications/LibreOffice.app on macOS.
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
WORD_CONVERSION_TIMEOUT_SECONDS=90
